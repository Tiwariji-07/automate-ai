<?xml version="1.0" encoding="utf-8"?>
<!-- The API key is encrypted with a Keystore key that never leaves the phone, so a restored copy is useless.
     Photos from flows stay private. Flows, chats and places are backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_settings.xml" />
        <exclude domain="sharedpref" path="triggers.xml" />
        <exclude domain="file" path="photos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_settings.xml" />
        <exclude domain="sharedpref" path="triggers.xml" />
        <exclude domain="file" path="photos/" />
    </device-transfer>
</data-extraction-rules>
